{
  "manifest_version": 3,
  "name": "ArrivalFiller — arrival card autofill for Indonesia & Thailand",
  "version": "1.1.0",
  "description": "Fills Indonesia's and Thailand's arrival cards from answers you gave once. You check every field and submit. Unofficial.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://allindonesia.imigrasi.go.id/*",
    "https://tdac.immigration.go.th/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "ArrivalFiller",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://allindonesia.imigrasi.go.id/*"
      ],
      "js": [
        "src/content/govForm.ts"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://tdac.immigration.go.th/*"
      ],
      "js": [
        "src/content/th/main.ts"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "homepage_url": "https://arrivalfiller.vercel.app",
  "minimum_chrome_version": "105"
}
